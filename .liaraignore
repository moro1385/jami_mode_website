# Only the files needed to install, build and run the Node storefront.
# This file takes precedence over .gitignore in the Liara CLI.
/*
!/package.json
!/package-lock.json
!/liara.json
!/server.js
!/index.html
!/vite.config.ts
!/postcss.config.js
!/tailwind.config.ts
!/tsconfig.json
!/tsconfig.app.json
!/tsconfig.node.json
!/components.json
!/src/
!/public/
!/config/
!/server/
!/scripts/

# npm is the release lockfile. Root Bun locks remain in the repository only.
/scripts/*
!/scripts/generate-sitemap.mjs
/src/test/
/src/**/*.test.*
/src/**/*.spec.*
/server/test-harness/

# Never ship local credentials, keys, archives or development metadata.
**/.git/
**/node_modules/
**/.env*
**/*.env
**/*.local
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.zip
**/*.tgz
**/*.log
**/.DS_Store
